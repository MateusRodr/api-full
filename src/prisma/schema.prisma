generator client {
  provider = "prisma-client-js"
    binaryTargets = ["native", "debian-openssl-1.1.x", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}


model Task {
  id        Int      @id @default(autoincrement())
  title     String
  status    String
}